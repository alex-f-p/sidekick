# Sidekick — server-side credentials only.
# Copy to .env.local if that file does not already exist.
# Never add these keys to browser code or NEXT_PUBLIC_/VITE_ variables.

# OpenAI project application key for Agents API and GPT-Live.
# Agents API requires api.agents.read, api.agents.write, api.responses.write.
# GPT-Live access must also be verified with this project/key.
OPENAI_API_KEY=

# Exa dashboard API key.
EXA_API_KEY=

# Ambiguous AI API key for the hackathon workspace/agent identity.
# Confirm the final agent authentication method during onboarding.
AMBIGUOUS_API_KEY=
